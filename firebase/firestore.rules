// TRPG 로그 사이트 Firestore 보안 규칙 · 규칙 버전 4
// 관리자 이메일 자리는 사이트 관리자 페이지에서 복사하면 자동으로 채워져요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사이트 주인
    function isOwner() {
      return request.auth != null && request.auth.token.email == "__OWNER_EMAIL__";
    }
    // 비밀번호로 연 사람인가 (비밀번호를 새로 만들면 다시 잠겨요)
    function unlocked(id) {
      return request.auth != null
        && exists(/databases/$(database)/documents/unlocks/$(id + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/unlocks/$(id + '_' + request.auth.uid)).data.pw
           == get(/databases/$(database)/documents/secrets/$(id)).data.pw;
    }
    // 비밀번호로 연 사람은 보기·고치기 모두 가능
    function canRead(id) {
      return isOwner() || unlocked(id);
    }

    // 열람 비밀번호: 주인만
    match /secrets/{id} {
      allow read, write: if isOwner();
    }
    // 비밀번호 입력 기록: 맞는 비밀번호일 때만 만들 수 있어요
    match /unlocks/{key} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && key == request.resource.data.scid + '_' + request.auth.uid
        && request.resource.data.pw == get(/databases/$(database)/documents/secrets/$(request.resource.data.scid)).data.pw;
    }
    // 규칙 버전 확인용 (사이트가 규칙이 최신인지 확인해요 · 숫자를 바꾸지 마세요)
    match /rulesv/{v} {
      allow get: if v == "4";
    }
    // 세션 후기 — 누구나 읽고, 시나리오를 연 사람이 써요. 쓴 브라우저(uid)와 주인만 고치고 지워요
    // (예전 후기는 그때 정한 '후기 비밀번호'를 한 번 넣으면 쓴 브라우저가 이 브라우저로 옮겨와요)
    function revOk(rid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/revunlocks/$(rid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/revunlocks/$(rid + '_' + request.auth.uid)).data.pw
           == get(/databases/$(database)/documents/revkeys/$(rid)).data.pw;
    }
    match /revkeys/{rid} {
      allow read, update, delete: if isOwner();
    }
    match /revunlocks/{key} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && key == request.resource.data.rid + '_' + request.auth.uid
        && request.resource.data.pw == get(/databases/$(database)/documents/revkeys/$(request.resource.data.rid)).data.pw;
    }
    function textOk() {
      return !('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 20000);
    }
    match /reviews/{rid} {
      allow read: if true;
      allow create: if request.auth != null
        && canRead(request.resource.data.scid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.size() <= 10 && textOk();
      allow update: if request.auth != null && request.resource.data.scid == resource.data.scid && textOk()
        && (isOwner()
          || (resource.data.get('uid', '') == request.auth.uid && request.resource.data.uid == request.auth.uid)
          || (revOk(rid) && request.resource.data.uid == request.auth.uid));
      allow delete: if isOwner()
        || (request.auth != null && resource.data.get('uid', '') == request.auth.uid);
    }
    // 로그 댓글 — 시나리오를 연 사람만 읽고 써요. 쓴 브라우저(uid)와 주인만 고치고 지워요
    match /comments/{cid} {
      allow read: if canRead(resource.data.scid);
      allow create: if request.auth != null
        && canRead(request.resource.data.scid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sid is string && request.resource.data.bid is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.size() <= 10;
      allow update: if request.auth != null
        && (isOwner() || resource.data.uid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updated'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null && (isOwner() || resource.data.uid == request.auth.uid);
    }
    // 시나리오
    match /scenarios/{id} {
      // 시나리오 목록·개요·등장인물은 누구나 볼 수 있어요 (로그는 아래 sessions에서 잠가요)
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || unlocked(id);
    }
    // 녹음과 대사
    match /sessions/{sid} {
      allow read: if isOwner() || canRead(resource.data.scid);
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (unlocked(resource.data.scid) && request.resource.data.scid == resource.data.scid);
      match /chunks/{c} {
        allow read: if isOwner() || canRead(get(/databases/$(database)/documents/sessions/$(sid)).data.scid);
        allow write: if isOwner() || unlocked(get(/databases/$(database)/documents/sessions/$(sid)).data.scid);
      }
    }
  }
}
